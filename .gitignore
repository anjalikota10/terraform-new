# Create .gitignore file
cat > .gitignore << 'EOF'
# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include tfplan files
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# IDE files
.idea/
.vscode/
*.swp
.DS_Store

# Backup files
*.backup
*.bak

# SSH keys
*.pem
*.key

# Environment files
.env
EOF
